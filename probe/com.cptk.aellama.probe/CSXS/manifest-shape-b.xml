<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  SHAPE B -- ONE <Extension> whose single HostList names both hosts.

  THIS IS THE DEFAULT -- the file install-probe.ps1 installs unless
  -Shape A is passed. It is the shape every shipped multi-host CEP
  manifest found in the wild actually uses. Its cost is that CEP
  auto-loads the one ScriptPath in BOTH hosts, so it must point at a
  loader that branches before touching any app.* API (./jsx/loader.jsx).

  It became the default on 2026-09-02 because shape A -- the
  per-extension HostList form -- did not list in After Effects on the
  owner's machine. Shape A is documented by Adobe but had NO field
  evidence behind it, and defaulting to it was a mistake rather than an
  experiment. It stays in manifest-shape-a.xml so the comparison can be
  made deliberately with -Shape A, once the probe is known to work.
-->
<ExtensionManifest ExtensionBundleId="com.cptk.aellama.probe"
                   ExtensionBundleName="AE Llama P0 Probe"
                   ExtensionBundleVersion="0.0.1"
                   Version="7.0"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.cptk.aellama.probe.both" Version="0.0.1"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,99.9]"/>
      <Host Name="PPRO" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.cptk.aellama.probe.both">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/loader.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AE Llama P0 Probe</Menu>
          <Geometry>
            <Size>
              <Height>700</Height>
              <Width>560</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
